{
  "name": "@xyzlz/dgcp-sdk",
  "version": "1.0.0-beta",
  "description": "SDK for DGCP that wraps the DGP apis",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup",
    "lint": "eslint src --ext .ts",
    "dev": "tsx src/main.ts",
    "publish": "npm publish --access restricted"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@xyzlz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYZLZ/dgcp-sdk.git"
  },
  "keywords": [
    "DGCP",
    "SDK",
    "API",
    "FileSystem",
    "mahoraga"
  ],
  "author": "Benjamin Viola",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/axios": "0.9.36",
    "@types/eslint": "9.6.1",
    "@types/multer": "2.0.0",
    "@types/node": "24.9.2",
    "eslint": "9.38.0",
    "eslint-plugin-import": "2.32.0",
    "globals": "16.4.0",
    "tsup": "^8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "dependencies": {
    "axios": "1.13.1",
    "form-data": "4.0.4"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#utils/*": "./src/utils/*",
    "#types/*": "./src/types/*",
    "#client/*": "./src/client/*",
    "#errors/*": "./src/errors/*",
    "#core/*": "./src/core/*",
    "#root/*": "./src/*"
  },
  "files": [
    "README.md",
    "dist/main.d.ts",
    "dist/main.js",
    "dist/main.js.map"
  ]
}
